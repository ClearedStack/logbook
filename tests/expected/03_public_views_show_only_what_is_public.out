-- Rule: the public views are the whole public surface. This is every column
-- they have and every row they show for the sample record. A new column, or a
-- private value showing up, changes this output and fails the test.
SELECT table_name AS view, string_agg(column_name, ', ' ORDER BY ordinal_position) AS columns
FROM information_schema.columns
WHERE table_schema = 'pub'
GROUP BY 1
ORDER BY 1;
       view        |                                            columns                                             
-------------------+------------------------------------------------------------------------------------------------
 component_health  | component, state, error_code, reported_at
 decision          | decision_id, item_id, evaluation_id, recommendation, outcome, overridden, reason, decided_at
 edit_proposal     | proposal_id, element_id, owner_repo, edit_class, status, payload, submitted_at, decided_at
 evaluation        | evaluation_id, item_id, profile, gates_passed, score, recommendation, split_flag, evaluated_at
 evaluation_factor | evaluation_id, item_id, factor, rating, weight, points
 evaluation_gate   | evaluation_id, item_id, gate, passed, reason
 item              | item_id, state, title, recorded_at, changed_at
 item_history      | entry_id, item_id, actor, from_state, to_state, error_code, note, recorded_at
 pause             | pause_id, item_id, worker, pattern, paused_at, replayed_at
 queue_depth       | worker, lane, waiting, claimed
 restore_drill     | drill_id, ran_at, passed, decrypt_passed, logbook_passed, plainforge_passed, lazarette_passed
(11 rows)

